# Dung de chay local; port mac dinh tren Windows la 3002.
# Khi deploy Render: KHONG set PORT; Render quan ly port theo moi truong.
PORT=3002
# Tuy chon: chi de test TURN tạm thời, KHONG dung thong tin co dinh lâu dài tren trang cong khai.
# /config se tra ve TURN credentials cho trinh duyet -> can credential ngan han cho production.
# TURN_URL=turn:example.com:3478,turns:example.com:5349
# TURN_USERNAME=temporary-user
# TURN_PASSWORD=temporary-password
